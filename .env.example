# ── Ollama ────────────────────────────────────────────────────────────────────
# Base URL of your local Ollama daemon
OLLAMA_BASE_URL=http://localhost:11434
# Chat / generation model (must be pulled: `ollama pull llama3.2:3b`)
OLLAMA_CHAT_MODEL=llama3.2:3b
# Embedding model (must be pulled: `ollama pull nomic-embed-text`, 768-dim)
OLLAMA_EMBED_MODEL=nomic-embed-text

# ── Vector store ──────────────────────────────────────────────────────────────
# Path to the persisted JSON vector index
VECTOR_STORE_PATH=./data/vector_index.json
# Directory where uploaded source files are kept
UPLOAD_DIR=./data/uploads

# ── Ingestion / chunking ──────────────────────────────────────────────────────
# Max chunk size in characters (~4 chars per token => ~600 tokens per chunk)
CHUNK_SIZE_CHARS=2400
# Chunk overlap in characters (15% of chunk size)
CHUNK_OVERLAP_CHARS=360

# ── Retrieval ─────────────────────────────────────────────────────────────────
# Number of chunks retrieved (top-k) after reranking
TOP_K=5
# Minimum cosine similarity (0..1) for a chunk to be considered relevant
RELEVANCE_THRESHOLD=0.3
# Max previous messages of the conversation sent to the model
HISTORY_WINDOW=8

# ── Upload limits ─────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=25

# ── Rate limiting (per client IP, sliding window) ─────────────────────────────
RATE_LIMIT_CHAT_REQUESTS=30
RATE_LIMIT_UPLOAD_REQUESTS=10
RATE_LIMIT_WINDOW_MS=60000

# ── Security ──────────────────────────────────────────────────────────────────
# When set, all mutating API calls must send this header: x-api-key: <value>
# Leave empty to disable the check (fine for local development).
API_KEY=

# ── Restricted web-search fallback ────────────────────────────────────────────
# Used ONLY when the knowledge base has no relevant chunks (KB-first policy).
# Search: DuckDuckGo (no API key). Set to false to disable internet access.
WEB_SEARCH_ENABLED=true
# Best knowledge-base score below which the web fallback kicks in
# (embedding models score ~0.4 even for unrelated text, so 0.55 ≈ "on topic")
WEB_FALLBACK_SCORE=0.55
# Max search results / pages fetched per question
WEB_MAX_RESULTS=4
# Max characters of text extracted per fetched page
WEB_PAGE_MAX_CHARS=4000
# Hard timeout for each search/fetch request (ms)
WEB_TIMEOUT_MS=10000